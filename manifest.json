{
  "manifest_version": 3,
  "name": "My Engine Arrows",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Analyze supported chessboards on the web with local Stockfish move arrows and evaluations.",
  "permissions": ["offscreen"],
  "action": {
    "default_title": "Chess Arrows: select a board"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["position.js", "boards.js", "history.js", "setup.js", "content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; object-src 'self'"
  }
}
